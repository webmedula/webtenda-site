# Um endereço só para cada página (evita "cópia sem página canônica" no Google).
RewriteEngine On

# /index.html e /pasta/index.html -> / e /pasta/
RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /pasta -> /pasta/
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
